        {
            "parameters": {
                "jsCode": "const users = [\n  { id: \"694ac74cc285820017920d6e\", name: \"Daniel\", whats: \"5511937524617\" },\n  { id: \"694acff8816ebc001e9cab67\", name: \"Angelina\", whats: \"5511973161872\" },\n  { id: \"694ac712b1088c001efc2637\", name: \"Leticia\", whats: \"5511998043118\" },\n  { id: \"696e6b245794b00017d62610\", name: \"Mauricio\", whats: \"5511948679342\" },\n  { id: \"694ad004e7a7720013f0b5ee\", name: \"Luana\", whats: \"5511919311319\" }\n];\n\n// ID recebido no input\nconst idAtual = $input.first().json.nome;\n\n// Função de rodízio circular\nfunction getProximoUsuario(id) {\n  const indexAtual = users.findIndex(user => user.id === id);\n\n  // Se não encontrar o ID, começa do primeiro\n  if (indexAtual === -1) {\n    return users[0];\n  }\n\n  const proximoIndex = (indexAtual + 1) % users.length;\n  return users[proximoIndex];\n}\n\nconst proximoUsuario = getProximoUsuario(idAtual);\n\n// Retorno no formato do n8n\nreturn [\n  {\n    json: {\n      id: proximoUsuario.id,\n      nome: proximoUsuario.name,\n      whats: proximoUsuario.whats\n    }\n  }\n];"
            },
